{
  "name": "mimocode",
  "displayName": "mimocode",
  "description": "Open Mimo Code using the VS Code terminal.",
  "version": "0.0.1",
  "publisher": "xucux",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaomiMiMo/MiMo-Code"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mimocode.openTerminal",
        "title": "Open MiMo Code",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "mimocode.openNewTerminal",
        "title": "Open MiMo Code in new tab",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "mimocode.addFilepathToTerminal",
        "title": "Add Filepath to MiMo Code"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mimocode.openNewTerminal",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mimocode.openTerminal",
        "title": "Open MiMo Code",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "mimocode.openNewTerminal",
        "title": "Open MiMo Code",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "mimocode.addFilepathToTerminal",
        "title": "MiMo Code: Insert File Reference",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "npx tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "npx tsc -p . --outDir out",
    "watch-tests": "npx tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "npx tsc --noEmit",
    "lint": "npx eslint src -c eslint.config.js",
    "test": "vscode-test",
    "vsce": "npx vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
